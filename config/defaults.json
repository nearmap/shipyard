{
  "tracker": "jira",
  "worktree": {
    "root": null
  },
  "memory": {
    "dir": null
  },
  "scratch": {
    "dir": null
  },
  "debug": {
    "evals": false
  },
  "ci": {
    "poll_timeout": 1800,
    "poll_interval": 30
  },
  "columns": {
    "backlog": null,
    "ready": null,
