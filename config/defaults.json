    "light_tier_max_files": 3,
    "max_spec_gate_rounds": 5
  },
  "ship": {
    "request_ci_reviewer": true,
    "merge_strategy": "squash",
    "escalation": {
      "max_needs_decision": 3,
      "max_needs_trace": 2,
      "max_gate_rounds": 5
    }
  },
  "skills": {
    "standards": null,
    "reviewer": null
  },
  "text": {
    "reader": "eli15 tldr"
  },
  "transcript": {
    "attach": false,
    "truncation_limits": {
      "tool_input": 1500,
      "tool_result": 4000,
      "thinking": 1200
    }
  },
  "redaction": {
    "extra_words": []
  },
  "models": {
    "tiers": {
      "frontier": "fable",
      "frontier_fallback": "opus",
      "standard": "opus",
      "cheap": "sonnet"
    },
    "agents": {
      "debate": { "model": "standard", "effort": "high" },
      "debater": { "model": "standard", "effort": "high" },
      "explain-author": { "model": "standard", "effort": "high" },
      "gate": { "model": "frontier", "effort": "max" },
      "hunt": { "model": "standard", "effort": "high" },
      "img-inspector": { "model": "cheap", "effort": "medium" },
      "repo-review": { "model": "frontier", "effort": "max" },
      "repo-standards": { "model": "standard", "effort": "high" },
      "seam": { "model": "standard", "effort": "high" },
      "ship-build": { "model": "standard", "effort": "high" },
      "ship-gate": { "model": "cheap", "effort": "high" },
      "ship-start": { "model": "cheap", "effort": "high" },
      "slice": { "model": "standard", "effort": "high" },
      "spec-gate": { "model": "standard", "effort": "high" },
      "sweep": { "model": "cheap", "effort": "high" },
      "trace": { "model": "standard", "effort": "high" }
    }
  }
